build/Release

# Dependency directories
# No trailing slash, deliberately. `node_modules/` matches a DIRECTORY only,
# so a node_modules SYMLINK — which is what a git worktree gets when it is
# pointed at the main checkout's install rather than running npm install twice
# — is not ignored, and `git add -A` commits it as a 120000 blob holding an
# absolute path from one machine. That happened (PR #74) and reached main.
node_modules
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

