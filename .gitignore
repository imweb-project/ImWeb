# AI / Editor specific
.aider*
.gemini/

# .claude: share the project knowledge, keep the machine-local bits out.
# settings.local.json holds absolute /Users paths and a per-machine permission
# allowlist; *-disabled/ is parked marketplace content. This repo is public.
.claude/*
!.claude/hooks/
!.claude/skills/
!.claude/agents/
!.claude/settings.json
# launch.json is commands and ports — identical on every clone, no /Users paths,
# no secrets. Untracked, each fresh clone left an agent to pick a dev port for
# itself, and it picked one that collided with the maintainer's own server.
!.claude/launch.json

# Backups
index_v4_working_do_not_touch.html

# Video files — too large for git; use imweb-prep.js to generate _imweb_ready/
_imweb_ready/*.mp4
_imweb_ready/*.webm
_imweb_ready/*.mov
_raw_videos/
Recordings/
seamless_videos/

# Brainstorm captures — heavy media, keep only the sentinel
Brainstorms/*
!Brainstorms/.gitkeep

# Ignore heavy video work folders and loose video files
_raw_videos/
_imweb_ready/
# Pre-faststart originals kept aside during the moov remux. Matches
# _imweb_ready_backup/ and any other _imweb_ready* staging dir, so a stray
# `git add .` cannot try to commit gigabytes of video.
_imweb_ready*/
*.mp4
*.webm
*.mov

# BUT allow the factory assets to be committed to GitHub!
!public/assets/*.mp4
!public/assets/*.webm
!public/assets/*.mov

# Personal project/session files (root and subdirs, but NOT public/)
*.imweb
*.imstate
*.imbank
!public/**/*.imweb
!public/**/*.imstate
!public/**/*.imbank
!public/**/*.webm
!public/**

# User bank/project saves must never ship — this must stay BELOW the
# !public/** negation (later rules win). Only MasterProject is factory.
public/Projects/*.imweb
!public/Projects/MasterProject.imweb
# .imbank needs the same treatment: !public/** above un-ignores it, so without
# this line every bank saved into public/Projects was one `git add .` from
# shipping — the exact thing the comment above exists to prevent.
public/Projects/*.imbank
!public/Projects/FactoryBank.imbank
# .imstate was the third one, and it was still open: a single exported Display
# State dropped into public/Projects had no re-ignore at all. No factory
# .imstate exists, so this needs no negation. Found by
# tests/audit-gitignore-banks.mjs on its first run.
public/Projects/*.imstate

# Re-ignore Finder metadata inside public/ (overrides the !public/** above)
public/.DS_Store
public/**/.DS_Store

# WebM recordings in public/assets
public/assets/*.webm

# Internal planning / AI session docs
MEMORY-REDESIGN.md
PERF-SPRINT.md
deepseek.md

# AGENTS.md and GEMINI.md are deliberately NOT ignored. They are instruction
# files, not planning notes: an instruction file that exists on one machine
# cannot instruct anyone else, and the gap that made this obvious was that
# neither carried the pointer to LEARNED.md's [advisory] lessons — the one tag
# with no mechanism behind it. tests/audit-learned-advisory-age.mjs now asserts
# both files exist and carry that pointer, so re-adding them here turns the
# suite red rather than silently un-teaching every non-Claude agent.

